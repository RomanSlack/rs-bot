<?xml version="1.0" encoding="utf-8"?>
<!--
  rs-bot: desk-scale wheeled biped whose wheels rotate flat to become its feet.

  Each leg is hip pitch, knee pitch, ankle pitch, ankle ROLL, wheel. The roll
  joint is the whole trick: turning it 90 deg stands the wheel's spin axis
  vertical, so the disc lies flat and its 80 mm face becomes the foot. No
  separate foot part, and the support polygon is centred under the axle, which
  is what the two earlier mechanisms could not achieve (docs/stage-0b.md).

  Ankle pitch keeps that face level as the leg pitches, and biasing it is the
  "bend in the ankle" that gives foot mode some compliance.

  Sized and mass-budgeted for the FINAL robot; see docs/mass-budget.md.
  Frame: robot faces +x, pitch is about +y, gravity -z.
-->
<mujoco model="rsbot">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.001" integrator="implicitfast" gravity="0 0 -9.81"/>

  <default>
    <geom friction="1.0 0.005 0.0001" solref="0.008 1" density="0"/>
    <joint damping="0.02" armature="0.002" frictionloss="0.008"/>

    <!-- STS3215-class serial bus servo: 2.9 N.m stall, 12 V.
         Leg joints run position mode, wheels run velocity mode (which is
         what the servo firmware actually gives you in continuous rotation). -->
    <default class="servo_pos">
      <position kp="12" kv="0.35" forcerange="-2.9 2.9"/>
    </default>
    <default class="servo_vel">
      <velocity kv="0.20" forcerange="-2.9 2.9"/>
    </default>

    <default class="leg">
      <geom type="capsule" size="0.014" rgba="0.75 0.76 0.78 1"/>
    </default>
    <!-- Ankle servo block. Must sit ABOVE the axle: the wheel face is only
         12 mm below it in foot mode, so anything hanging lower becomes the
         real ground contact and steals the 80 mm foot. -->
    <default class="ankle">
      <geom type="box" size="0.015 0.014 0.017" pos="0 0 0.020"
            rgba="0.85 0.35 0.15 1"/>
    </default>
    <!-- The tyre is the foot, so it needs grip in both roles. -->
    <default class="wheel">
      <geom type="cylinder" size="0.040 0.012" friction="1.6 0.02 0.002"
            rgba="0.15 0.15 0.17 1"/>
    </default>
  </default>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
    <headlight ambient="0.45 0.45 0.45" diffuse="0.55 0.55 0.55" specular="0.1 0.1 0.1"/>
    <map znear="0.02" zfar="30"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.22 0.23 0.25" rgb2="0.28 0.29 0.31"/>
    <material name="grid" texture="grid" texrepeat="12 12" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" diffuse="0.7 0.7 0.7"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="grid"
          friction="1.0 0.005 0.0001"/>

    <body name="torso" pos="0 0 0.247">
      <freejoint name="root"/>
      <!-- Structure, Pi, battery, plus ballast for the arms and head that
           arrive at stage 4. The x offset is solved for at load time so the
           standing CoM sits over the axle; see model.load(). -->
      <geom name="torso" type="box" size="0.045 0.035 0.090" pos="0.0085 0 0.090"
            mass="1.230" rgba="0.30 0.55 0.85 1"/>
      <site name="imu" pos="0 0 0.02"/>

      <!--LEGS-->
    </body>
  </worldbody>

  <!--EXCLUDES-->

  <actuator>
    <position class="servo_pos" name="hip_l"   joint="hip_l"   ctrlrange="-0.60 1.40"/>
    <position class="servo_pos" name="knee_l"  joint="knee_l"  ctrlrange="-2.00 0.05"/>
    <position class="servo_pos" name="apit_l"  joint="ankle_pitch_l" ctrlrange="-1.60 1.60"/>
    <position class="servo_pos" name="aroll_l" joint="ankle_roll_l"  ctrlrange="-0.10 1.75"/>
    <velocity class="servo_vel" name="wheel_l" joint="wheel_l" ctrlrange="-40 40"/>

    <position class="servo_pos" name="hip_r"   joint="hip_r"   ctrlrange="-0.60 1.40"/>
    <position class="servo_pos" name="knee_r"  joint="knee_r"  ctrlrange="-2.00 0.05"/>
    <position class="servo_pos" name="apit_r"  joint="ankle_pitch_r" ctrlrange="-1.60 1.60"/>
    <position class="servo_pos" name="aroll_r" joint="ankle_roll_r"  ctrlrange="-0.10 1.75"/>
    <velocity class="servo_vel" name="wheel_r" joint="wheel_r" ctrlrange="-40 40"/>
  </actuator>

  <sensor>
    <framequat     name="imu_quat"  objtype="site" objname="imu"/>
    <gyro          name="imu_gyro"  site="imu"/>
    <accelerometer name="imu_acc"   site="imu"/>
    <jointpos name="apit_l_pos"  joint="ankle_pitch_l"/>
    <jointpos name="aroll_l_pos" joint="ankle_roll_l"/>
    <jointvel name="wheel_l_vel" joint="wheel_l"/>
    <jointpos name="apit_r_pos"  joint="ankle_pitch_r"/>
    <jointpos name="aroll_r_pos" joint="ankle_roll_r"/>
    <jointvel name="wheel_r_vel" joint="wheel_r"/>
  </sensor>

  <keyframe>
    <!-- qpos: root(7) + [hip knee ankle_pitch ankle_roll wheel] x2 -->
    <key name="stance"
         qpos="0 0 0.247 1 0 0 0   0.35 -0.70 0.35 0 0   0.35 -0.70 0.35 0 0"
         ctrl="0.35 -0.70 0.35 0 0   0.35 -0.70 0.35 0 0"/>
  </keyframe>
</mujoco>
